# Model provider API keys — set the one you're using
# get a key from https://platform.claude.com
ANTHROPIC_API_KEY=<sk-ant-your-key>
#Haiku is the low cost model 
#Sonnet is a higher cost model
UNDERWRITING_MODEL=anthropic:claude-haiku-5-5
#UNDERWRITING_MODEL=anthropic:claude-sonnet-5-5
# LangSmith — tracing and observability
# get a free key at https://smith.langchain.com/
LANGSMITH_API_KEY=<langsmith-api-key>
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=underwriting_deep_agent
# Non-US region? Uncomment your endpoint (else your API key won't authenticate):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC